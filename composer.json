{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "stackski/stackstra-laravel",
    "description": "Laravel service provider bridge for the Stackstra PHP helper library.",
    "version": "1.0.0",
    "type": "library",
    "license": "MIT",
    "repositories": [
        {
            "type": "git",
            "url": "https://github.com/STACKSKI/STACKSTRA"
        }
    ],
    "require": {
        "php": "^8.5",
        "stackski/stackstra": "dev-master",
        "illuminate/support": "^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Stackstra\\Laravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Stackstra\\Laravel\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Stackstra\\Laravel\\StackstraServiceProvider"
            ]
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0",
        "phpunit/phpunit": "^12.0"
    }
}
